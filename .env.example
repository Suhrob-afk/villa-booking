# Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=
# Supabase anon (publishable) key
VITE_SUPABASE_ANON_KEY=
# Optional: set to a Telegram id to run the app in a normal browser without Telegram.
# Requires ALLOW_DEV_LOGIN=true on the telegram-auth Edge Function. Never set in production.
VITE_DEV_TELEGRAM_ID=
